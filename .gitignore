# ---- Personal data: real bet slips ---------------------------------------
# Screenshots and their expected JSON contain real slip numbers, stakes and
# betting history. They stay on this machine only.
/tests/MyBet.Tests/Samples/*
!/tests/MyBet.Tests/Samples/README.md

# Any folder you point the importer or MYBET_SAMPLES at
/screenshots/
/slips/
/import/
/data/

# The future SQLite database holds every imported bet
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- Local settings and secrets ------------------------------------------
# appsettings.json is committed (no secrets in it). Machine-specific
# overrides go in one of these instead.
appsettings.Local.json
appsettings.*.local.json
appsettings.Development.json
.env
.env.*

